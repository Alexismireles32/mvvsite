---
import Layout from '../layouts/Layout.astro';

// Import with the ACTUAL filenames (lowercase with dashes)
import { Navbar6 } from '../components/navbar-06.jsx';
import { WhatsAppProvider } from '../components/home-wrapper.jsx';
import BlogIntro from '../components/blog-intro.astro';
import { Blog44 } from '../components/blog-44.jsx';
import { Footer2 } from '../components/footer-02.jsx';
---

<Layout
  title="Blog de Suplementos Naturales y Guías Para Bajar de Peso"
  description="Guías y comparativas sobre suplementos naturales para bajar de peso: cómo acelerar el metabolismo, si funcionan las pastillas y cuál elegir en México."
>
  <WhatsAppProvider client:load>
    <Navbar6 client:load />

    {/* PRIORIDAD: Mostrar artículos primero. Blog44 es el ÚNICO listado del
        blog: renderiza los 3 artículos reales una sola vez, sin hidratar
        (no tiene interactividad). */}
    <Blog44 />

    {/* Texto SEO al final (sigue indexándose) */}
    <BlogIntro />

    <Footer2 client:idle />
  </WhatsAppProvider>
</Layout>
