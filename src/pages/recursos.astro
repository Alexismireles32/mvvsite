        cta: "Ver el top 5 de quemadores de grasa",
        icon: "🏆"
      },
      {
        title: "SOS Burn vs Body Shape: ¿Cuál Quemador Elegir?",
        url: "/recursos/comparativas/sos-burn-vs-body-shape/",
        description: "Comparativa honesta: SOS Burn (agresivo) vs Body Shape (suave). Diferencias, cuándo usar cada uno y resultados reales.",
        cta: "Ver la comparativa SOS Burn vs Body Shape",
        icon: "🔥"
      }
    ]
  }
];
---

<Layout
  title="Bajar de Peso Naturalmente: Guías y Comparativas | MVV Natural"
  description="Comparativas de productos, guías completas y consejos expertos para ayudarte a elegir el tratamiento correcto y alcanzar tus objetivos de pérdida de peso."
>
  <WhatsAppProvider client:load>
    <Navbar6 client:load />

    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-como to-[#3d6849] px-[5%] py-16 md:py-24 lg:py-32">
      <div class="container max-w-4xl mx-auto text-center text-white">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6 text-white">
          Recursos Para Bajar de Peso
        </h1>
        <p class="text-lg md:text-xl text-white/90 leading-relaxed">
          Comparativas honestas de productos, guías completas y consejos expertos basados en 15 años de experiencia. Te ayudamos a elegir el tratamiento correcto para alcanzar tus objetivos de forma natural.
        </p>
      </div>
    </section>

    <!-- Índice por tema -->
    <nav class="px-[5%] py-8 border-b border-gray-200/60 bg-white" aria-label="Temas de recursos">
      <div class="container max-w-6xl mx-auto">
        <ul class="flex flex-wrap justify-center gap-3">
          {topicGroups.map((group) => (
            <li>
              <a
                href={`#${group.id}`}
                class="inline-flex items-center min-h-[44px] rounded-full border border-gray-200 bg-white px-5 py-2 text-sm font-semibold text-gray-800 transition-colors hover:border-como hover:text-como"
              >
                {group.heading}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <!-- Grupos temáticos -->
    {topicGroups.map((group, groupIndex) => (
      <section
        id={group.id}
        class:list={[
          "px-[5%] py-16 md:py-20 scroll-mt-24",
          groupIndex % 2 === 1 && "bg-gradient-to-b from-ecru-white to-white"
        ]}
      >
        <div class="container max-w-6xl mx-auto">
          <div class="text-center mb-12 md:mb-16">
            <span class="inline-block text-sm font-semibold text-como uppercase tracking-wider mb-3">{group.eyebrow}</span>
            <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-4">
              {group.heading}
            </h2>
            <p class="text-lg md:text-xl text-text-secondary max-w-2xl mx-auto leading-relaxed">
              {group.intro}
            </p>
          </div>

          <div class="grid gap-6 md:grid-cols-2">
            {group.items.map((item) => (
              <a href={item.url} class="group relative flex flex-col bg-white border border-gray-200/60 rounded-3xl p-8 transition-all duration-500 hover:border-como/50 hover:shadow-2xl hover:-translate-y-2 active:scale-[0.98] overflow-hidden">
                {/* Decorative gradient overlay */}
                <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-como/10 to-transparent rounded-bl-full opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

                {/* Content */}
                <div class="relative flex flex-col flex-1">
                  <div class="flex items-center gap-4 mb-4">
                    <div class="text-5xl opacity-90 group-hover:scale-110 group-hover:opacity-100 transition-all duration-300">
                      {item.icon}
                    </div>
                    <div class="h-1 flex-1 bg-gradient-to-r from-como to-transparent rounded-full"></div>
                  </div>

                  <h3 class="text-2xl font-bold mb-3 text-gray-900 group-hover:text-como transition-colors duration-300 leading-snug">
                    {item.title}
                  </h3>
                  <p class="text-base text-text-secondary leading-relaxed mb-6 flex-1">
                    {item.description}
                  </p>

                  {/* CTA con texto descriptivo */}
                  <div class="inline-flex items-center gap-2 text-sm font-bold text-como group-hover:gap-3 transition-all duration-300">
                    <span>{item.cta}</span>
                    <svg class="w-5 h-5 flex-shrink-0 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </div>
                </div>

                {/* Bottom accent */}
                <div class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-como/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))}

    <!-- CTA Section -->
    <section class="px-[5%] pb-16 md:pb-20 bg-gradient-to-b from-white to-ecru-white">
      <div class="container max-w-6xl mx-auto">
        <div class="relative overflow-hidden bg-gradient-to-br from-como via-[#3d6849] to-como rounded-3xl p-10 md:p-14 text-white shadow-2xl">
          {/* Background pattern */}
          <div class="absolute inset-0 opacity-10">
            <div class="absolute top-0 left-0 w-full h-full" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
          </div>

          <div class="relative text-center max-w-3xl mx-auto">
            <div class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider mb-4 opacity-90">
              <span class="w-8 h-[2px] bg-white"></span>
              <span>Asesoría Personalizada</span>
              <span class="w-8 h-[2px] bg-white"></span>
            </div>

            <h2 class="text-3xl md:text-4xl font-bold mb-4 leading-tight">
              ¿Necesitas Orientación Específica?
            </h2>
            <p class="text-lg md:text-xl text-white/90 mb-8 leading-relaxed max-w-2xl mx-auto">
              Nuestro equipo tiene 15 años ayudando a miles de clientes. Te asesoramos gratis según tu perfil y objetivos.
            </p>

            <button
              id="open-whatsapp-expert"
              class="group inline-flex items-center justify-center gap-3 bg-white text-como font-bold text-base px-8 py-4 md:px-12 md:py-6 shadow-2xl hover:shadow-3xl active:scale-95 md:hover:scale-105 transition-all duration-300 rounded-full min-h-[56px]"
            >
              <span class="text-2xl">💬</span>
              <span>Hablar con Experto</span>
              <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </button>

            <script is:inline>
              document.addEventListener('DOMContentLoaded', () => {
                const expertButton = document.getElementById('open-whatsapp-expert');

                if (expertButton) {
                  expertButton.addEventListener('click', () => {
                    const floatButton = document.querySelector('[aria-label="Contactar por WhatsApp"]');

                    if (floatButton) {
                      floatButton.click();
                    } else {
                      setTimeout(() => {
                        const floatButtonRetry = document.querySelector('[aria-label="Contactar por WhatsApp"]');
                        if (floatButtonRetry) {
                          floatButtonRetry.click();
                        }
                      }, 100);
                    }
                  });
                }
              });
            </script>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </WhatsAppProvider>
</Layout>
