---
import Layout from '../layouts/Layout.astro';

// Import with the ACTUAL filenames (lowercase with dashes)
import { Navbar6 } from '../components/navbar-06.jsx';
import { WhatsAppProvider } from '../components/home-wrapper.jsx';
import { Faq7 } from '../components/faq-07.jsx';
import { Footer2 } from '../components/footer-02.jsx';

// FAQPage Schema
// IMPORTANTE: estas 8 preguntas y respuestas son una versión abreviada del texto
// visible que renderiza src/components/faq-07.jsx. Si editas, agregas o eliminas
// una pregunta en faq-07.jsx, actualiza este bloque en el mismo commit: Google
// exige que el contenido del FAQPage schema coincida con el contenido visible
// de la página, y si divergen la marcación deja de ser elegible para rich results.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Cuánto peso puedo perder con sus productos naturales?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nuestros clientes pierden en promedio 15-25 kilos en 2-3 meses con nuestro sistema completo. Los resultados varían según tu metabolismo, peso inicial y constancia."
      }
    },
    {
      "@type": "Question",
      "name": "¿Son seguros los quemadores de grasa naturales? ¿Tienen efectos secundarios?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nuestros productos son 100% naturales y seguros. Contienen extractos de plantas como té verde, garcinia cambogia y ginseng. Algunos clientes pueden experimentar leve aumento de energía al inicio, pero sin nerviosismo ni insomnio."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tiempo tarda en llegar mi pedido a México y USA?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "México: 1-3 días hábiles con Estafeta o Fedex. USA: 3-5 días hábiles con USPS correo postal. Todos los envíos incluyen número de rastreo."
      }
    },
    {
      "@type": "Question",
      "name": "¿Necesito hacer dieta estricta o ejercicio para ver resultados?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No es obligatorio, pero ayuda muchísimo. Nuestros productos funcionan solos: aceleran tu metabolismo, queman grasa y controlan el apetito automáticamente."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuál es el mejor producto para empezar a bajar de peso?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nuestro bestseller es Duo-60 Fusion Xtreme - el quemador de grasa más potente. Es perfecto para principiantes porque acelera el metabolismo 3x, controla antojos y quema grasa abdominal."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué formas de pago aceptan en México y USA?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "México: Transferencia bancaria, depósito OXXO, Mercado Pago y Kueski Pay. USA: Zelle, PayPal, CashApp y tarjetas de crédito/débito."
      }
    },
    {
      "@type": "Question",
      "name": "¿Puedo tomar varios productos juntos para adelgazar más rápido?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí, muchos clientes combinan productos para resultados acelerados. Las combinaciones más efectivas son: Duo-60 Fusion + SOS Burn, Duo-60 + 30 Day Detox, o Lipo HD + Chupa Panza."
      }
    },
    {
      "@type": "Question",
      "name": "¿Por qué sus productos funcionan mejor que otros del mercado?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "15 años de experiencia perfeccionando fórmulas naturales efectivas. Usamos extractos concentrados de máxima pureza que atacan el problema desde 3 ángulos: aceleran metabolismo, queman grasa almacenada y controlan apetito."
      }
    }
  ]
};
---

<Layout 
  title="¿Funcionan Las Pastillas Para Bajar de Peso? Preguntas Frecuentes"
  description="Todas tus dudas respondidas: ¿Cuánto peso voy a perder? ¿Son seguras las pastillas naturales? ¿Cuánto tarda el envío a México? Respuestas honestas sin vueltas."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
  
  <WhatsAppProvider client:load>
    <Navbar6 client:load />

    <!--
      H1 a nivel de página (Astro estático, sin JavaScript).
      El encabezado de faq-07.jsx es un h2 de sección, así que este es el único h1
      del documento. No lo elimines sin sustituirlo por otro h1.
    -->
    <section class="bg-gradient-to-br from-como to-[#3d6849] px-[5%] py-12 md:py-16 lg:py-20">
      <div class="container max-w-4xl mx-auto text-center text-white">
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold leading-tight mb-5 text-white">
          ¿Funcionan Las Pastillas Para Bajar de Peso? Preguntas Frecuentes
        </h1>
        <p class="text-base md:text-lg text-white/90 leading-relaxed">
          Respuestas honestas a las dudas que más nos escriben por WhatsApp: cuánto peso se pierde,
          si los suplementos naturales son seguros, cuánto tarda el envío a México y Estados Unidos
          y qué producto conviene según tu objetivo.
        </p>
      </div>
    </section>

    <Faq7 client:idle />
    <Footer2 client:idle />
  </WhatsAppProvider>
</Layout>

