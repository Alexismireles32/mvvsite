---
import Layout from '../layouts/Layout.astro';
import { Navbar6 } from '../components/navbar-06.jsx';
import { Footer2 } from '../components/footer-02.jsx';

const populares = [
  { url: '/duo-60-fusion/', name: 'Duo 60 Fusion Xtreme' },
  { url: '/sosburn/', name: 'SOS Burn' },
  { url: '/meizitang-soft-gel/', name: 'Meizitang Soft Gel' },
  { url: '/chupapanza/', name: 'Chupa Panza' },
  { url: '/alphaglow/', name: 'Alpha Glow' },
  { url: '/lidabooster/', name: 'Lida Booster' },
];
---

<Layout
  title="Página No Encontrada (404) | MVV Natural"
  description="La página que buscas no existe o cambió de dirección. Explora nuestro catálogo de suplementos naturales para bajar de peso o escríbenos por WhatsApp."
  noindex={true}
>
  <Navbar6 client:load />

  <section class="px-[5%] py-16 md:py-24 lg:py-28">
    <div class="container mx-auto max-w-2xl text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-text-secondary">Error 404</p>
      <h1 class="mb-5 text-4xl font-bold md:mb-6 md:text-6xl">
        Esta página no existe
      </h1>
      <p class="mb-8 text-base text-text-secondary md:text-lg">
        Puede que el enlace esté roto o que el producto haya cambiado de dirección.
        Aquí tienes los caminos más útiles:
      </p>

      <div class="mb-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/productos/"
          class="rounded-lg bg-como px-6 py-3 font-semibold text-white transition-colors hover:bg-como/90"
        >
          Ver todos los productos
        </a>
        <a
          href="https://wa.me/526312982043?text=Hola%2C%20llegu%C3%A9%20a%20una%20p%C3%A1gina%20que%20no%20existe%20en%20su%20sitio%20y%20busco%20un%20producto"
          target="_blank"
          rel="noopener"
          class="rounded-lg border-2 border-como px-6 py-3 font-semibold text-como transition-colors hover:bg-como hover:text-white"
        >
          Preguntar por WhatsApp
        </a>
      </div>

      <div class="rounded-2xl border-2 border-como/20 bg-ecru-white p-6 text-left">
        <h2 class="mb-4 text-center text-lg font-semibold">Productos más buscados</h2>
        <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          {populares.map((p) => (
            <li>
              <a href={p.url} class="text-text-secondary underline-offset-4 hover:text-como hover:underline">
                {p.name}
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-5 text-center text-sm text-text-secondary">
          También puedes revisar nuestras
          <a href="/recursos/" class="text-como underline underline-offset-4">guías para bajar de peso</a>
          o el <a href="/blog/" class="text-como underline underline-offset-4">blog</a>.
        </p>
      </div>
    </div>
  </section>

  <Footer2 client:idle />
</Layout>
