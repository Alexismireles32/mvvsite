---
import Layout from '../../../layouts/Layout.astro';
import { Navbar6 } from '../../../components/navbar-06.jsx';
import { WhatsAppProvider } from '../../../components/home-wrapper.jsx';
import Footer from '../../../components/Footer.astro';

// BreadcrumbList Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": "https://www.mvvnaturales.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Recursos",
      "item": "https://www.mvvnaturales.com/recursos/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Duo 60 Fusion vs Lida Booster: Comparativa Honesta | MVV Natural",
      "item": "https://www.mvvnaturales.com/recursos/comparativas/duo-60-vs-lida/"
    }
  ]
};
---

<Layout 
  title="Duo 60 Fusion vs Lida Booster: Comparativa Honesta | MVV Natural"
  description="Comparativa detallada entre Duo 60 Fusion Xtreme y Lida Booster. Diferencias, ventajas, cuándo elegir cada uno y resultados observados."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <WhatsAppProvider client:load>
    <Navbar6 client:load />

    <article class="px-[5%] py-12 md:py-16 lg:py-20">
      <div class="container max-w-4xl mx-auto">
        
        <!-- Header -->
        <header class="mb-12 md:mb-16">
          <div class="inline-flex items-center gap-2 text-sm font-semibold text-como uppercase tracking-wider mb-4">
            <span class="w-8 h-[2px] bg-como"></span>
            <span>Análisis Profesional</span>
            <span class="w-8 h-[2px] bg-como"></span>
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight tracking-tight">
            Duo 60 Fusion vs Lida Booster
          </h1>
          <p class="text-lg md:text-xl text-text-secondary leading-relaxed max-w-3xl">
            Después de 15 años vendiendo ambos productos, esta comparativa honesta te dice exactamente cuál necesitas según tu objetivo, experiencia y tipo de cuerpo. Sin promesas vacías.
          </p>
        </header>

        <!-- Quick Comparison Table -->
        <section class="mb-12">
          <div class="relative bg-gradient-to-br from-white via-gray-50 to-white border border-gray-200/60 rounded-3xl p-8 md:p-10 shadow-xl">
            <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-como via-[#3d6849] to-como rounded-t-3xl"></div>
            <h2 class="text-2xl md:text-3xl font-bold mb-8 text-center text-gray-900">Comparación de Características</h2>
            <div class="overflow-x-auto">
              <table class="w-full text-sm md:text-base">
                <thead>
                  <tr class="border-b-2 border-gray-300">
                    <th class="text-left py-4 px-4 font-bold text-como text-base">Característica</th>
                    <th class="text-center py-4 px-4 font-bold text-gray-900 bg-como/5">Duo 60 Fusion</th>
                    <th class="text-center py-4 px-4 font-bold text-gray-900">Lida Booster</th>
                  </tr>
                </thead>
                <tbody>
                <tr class="border-b border-gray-200 hover:bg-gray-50 transition-colors">
                  <td class="py-4 px-4 font-semibold text-gray-800">Fórmula</td>
                  <td class="text-center py-4 px-4 bg-como/5">Termogénica agresiva</td>
                  <td class="text-center py-4 px-4">Bloqueador de grasa suave</td>
                </tr>
                <tr class="border-b border-gray-200 hover:bg-gray-50 transition-colors">
                  <td class="py-4 px-4 font-semibold text-gray-800">Ideal para</td>
                  <td class="text-center py-4 px-4 bg-como/5">Bajar 15-25 kilos rápido</td>
                  <td class="text-center py-4 px-4">Bajar 10-20 kilos gradual</td>
                </tr>
                <tr class="border-b border-gray-200 hover:bg-gray-50 transition-colors">
                  <td class="py-4 px-4 font-semibold text-gray-800">Modo de acción</td>
                  <td class="text-center py-4 px-4 bg-como/5">Quema grasa activamente</td>
                  <td class="text-center py-4 px-4">Bloquea absorción de grasa</td>
                </tr>
                <tr class="border-b border-gray-200 hover:bg-gray-50 transition-colors">
                  <td class="py-4 px-4 font-semibold text-gray-800">Energía</td>
                  <td class="text-center py-4 px-4 bg-como/5">🔥🔥🔥 Alta</td>
                  <td class="text-center py-4 px-4">🔥 Media</td>
                </tr>
                <tr class="border-b border-gray-200 hover:bg-gray-50 transition-colors">
                  <td class="py-4 px-4 font-semibold text-gray-800">Sensibilidad</td>
                  <td class="text-center py-4 px-4 bg-como/5">Personas que toleran cafeína</td>
                  <td class="text-center py-4 px-4">Personas sensibles al café</td>
                </tr>
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="py-4 px-4 font-semibold text-gray-800">Resultados*</td>
                  <td class="text-center py-4 px-4 bg-como/5">8-15 kilos / 30 días</td>
                  <td class="text-center py-4 px-4">10-20 kilos / 60-90 días</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="text-xs text-text-secondary mt-4 italic text-center">
            *Resultados observados varían según metabolismo, compromiso con dieta y ejercicio
          </p>
        </div>
        </section>

        <!-- Duo 60 Fusion Deep Dive -->
        <section class="mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-6">🔥 Duo 60 Fusion Xtreme: La Máquina Quemadora</h2>
          
          <div class="bg-white border-2 border-como rounded-2xl p-6 md:p-8 mb-6">
            <img 
              src="https://res.cloudinary.com/dsulhqvza/image/upload/f_auto,q_auto,w_1200/v1761575568/Duo-60fusion_xhsjhs.png"
              alt="Duo 60 Fusion Xtreme - MVV Natural"
              class="w-full max-w-md mx-auto rounded-xl mb-6"
            />
            
            <h3 class="text-2xl font-bold mb-4 text-como">¿Cómo Funciona?</h3>
            <p class="text-base md:text-lg text-text-secondary leading-relaxed mb-4">
              Duo 60 Fusion es nuestro <strong>quemador de grasa más agresivo</strong>. Funciona acelerando tu metabolismo hasta 3 veces más de lo normal, haciendo que tu cuerpo queme calorías incluso cuando estás en reposo.
            </p>

            <h3 class="text-2xl font-bold mb-4 text-como">Ingredientes Clave:</h3>
            <ul class="space-y-2 mb-6">
              <li class="flex items-start gap-3">
                <span class="text-como font-bold text-xl">•</span>
                <span><strong>Té Verde (EGCG):</strong> Acelera metabolismo 30%</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-como font-bold text-xl">•</span>
                <span><strong>Guaraná + Cafeína:</strong> Energía todo el día</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-como font-bold text-xl">•</span>
                <span><strong>L-Carnitina:</strong> Transporta grasa para quemar</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-como font-bold text-xl">•</span>
                <span><strong>Sinefrina:</strong> Ingrediente termogénico de origen cítrico</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-como font-bold text-xl">•</span>
                <span><strong>2 cápsulas diarias:</strong> 1 dorada AM, 1 negra PM</span>
              </li>
            </ul>

            <h3 class="text-2xl font-bold mb-4 text-como">Ventajas ✅</h3>
            <ul class="space-y-2 mb-6">
              <li class="flex items-start gap-3">
                <span class="text-green-600 font-bold text-xl">✓</span>
                <span><strong>Resultados más rápidos:</strong> Algunos clientes reportan 8-15 kilos en 30-60 días. Los resultados varían según cada persona.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-green-600 font-bold text-xl">✓</span>
                <span><strong>Energía todo el día:</strong> Sin cansancio, sin flojera</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-green-600 font-bold text-xl">✓</span>
                <span><strong>Quema grasa 24/7:</strong> Incluso mientras duermes</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-green-600 font-bold text-xl">✓</span>
                <span><strong>Control de apetito:</strong> Elimina antojos por azúcar</span>
              </li>
            </ul>

            <h3 class="text-2xl font-bold mb-4 text-como">Consideraciones ⚠️</h3>
            <ul class="space-y-2">
              <li class="flex items-start gap-3">
                <span class="text-yellow-600 font-bold text-xl">!</span>
                <span>No ideal si eres sensible a la cafeína o tienes hipertensión</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-yellow-600 font-bold text-xl">!</span>
                <span>Tomar con agua abundante (2-3 litros diarios)</span>
              </li>
            </ul>
          </div>

          <a href="/duo-60-fusion/" class="inline-flex items-center gap-2 text-como font-bold hover:underline">
            Ver más sobre Duo 60 Fusion →
          </a>
        </section>

        <!-- Lida Booster Deep Dive -->
        <section class="mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-6">🌸 Lida Booster: El Bloqueador Suave</h2>
          
          <div class="bg-white border-2 border-gray-200 rounded-2xl p-6 md:p-8 mb-6">
            <img 
              src="https://res.cloudinary.com/dsulhqvza/image/upload/f_auto,q_auto,w_1200/v1761575576/Lidabooster_xd5mo9.png"
              alt="Lida Booster - MVV Natural"
              class="w-full max-w-md mx-auto rounded-xl mb-6"
            />
            
            <h3 class="text-2xl font-bold mb-4 text-como">¿Cómo Funciona?</h3>
            <p class="text-base md:text-lg text-text-secondary leading-relaxed mb-4">
              Lida Booster es diferente: <strong>NO quema grasa activamente</strong>. En su lugar, <strong>bloquea hasta 30% de la grasa</strong> que consumes antes de que tu cuerpo la absorba. Es un "escudo" natural contra calorías.
            </p>

            <h3 class="text-2xl font-bold mb-4 text-como">Ingredientes Clave:</h3>
            <ul class="space-y-2 mb-6">
              <li class="flex items-start gap-3">
                <span class="text-como font-bold text-xl">•</span>
                <span><strong>Loto Sagrado (Lotus):</strong> Bloquea absorción de grasa hasta 30%</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-como font-bold text-xl">•</span>
                <span><strong>Cassia (Sen):</strong> Limpieza intestinal suave</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-como font-bold text-xl">•</span>
                <span><strong>Garcinia Cambogia:</strong> Reduce antojos y controla apetito</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-como font-bold text-xl">•</span>
                <span><strong>Fibra Natural:</strong> Aumenta saciedad</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-como font-bold text-xl">•</span>
                <span><strong>1 cápsula diaria:</strong> Antes del desayuno con agua tibia</span>
              </li>
            </ul>

            <h3 class="text-2xl font-bold mb-4 text-como">Ventajas ✅</h3>
            <ul class="space-y-2 mb-6">
              <li class="flex items-start gap-3">
                <span class="text-green-600 font-bold text-xl">✓</span>
                <span><strong>Sin cafeína:</strong> Sin nerviosismo, sin insomnio</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-green-600 font-bold text-xl">✓</span>
                <span><strong>Enfoque sostenible:</strong> Mantén tu peso con los hábitos que construyes durante el tratamiento</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-green-600 font-bold text-xl">✓</span>
                <span><strong>Ideal para sensibles:</strong> Personas que no toleran cafeína</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-green-600 font-bold text-xl">✓</span>
                <span><strong>Efecto permanente:</strong> Creas nuevos hábitos alimenticios</span>
              </li>
            </ul>

            <h3 class="text-2xl font-bold mb-4 text-como">Consideraciones ⚠️</h3>
            <ul class="space-y-2">
              <li class="flex items-start gap-3">
                <span class="text-yellow-600 font-bold text-xl">!</span>
                <span>Resultados más graduales: algunos clientes reportan 10-20 kilos en 2-3 meses. Los resultados varían según cada persona.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-yellow-600 font-bold text-xl">!</span>
                <span>Esencial comer balanceado: el producto bloquea grasa, no la crea milagros</span>
              </li>
            </ul>
          </div>

          <a href="/lidabooster/" class="inline-flex items-center gap-2 text-como font-bold hover:underline">
            Ver más sobre Lida Booster →
          </a>
        </section>

        <!-- When to Choose -->
        <section class="mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-8">🎯 ¿Cuándo Elegir Cada Uno?</h2>
          
          <div class="grid gap-6 md:grid-cols-2">
            <!-- Duo 60 When -->
            <div class="bg-gradient-to-br from-como to-[#3d6849] rounded-2xl p-6 md:p-8 text-white">
              <h3 class="text-2xl font-bold mb-4">🔥 Elige Duo 60 si...</h3>
              <ul class="space-y-3">
                <li class="flex items-start gap-3">
                  <span class="text-xl">✓</span>
                  <span>Tienes más de 20 kilos que perder</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-xl">✓</span>
                  <span>Necesitas resultados rápidos (evento, boda, evento)</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-xl">✓</span>
                  <span>Tomas café diario sin problemas</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-xl">✓</span>
                  <span>Tienes metabolismo muy lento (todo lo subes fácil)</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-xl">✓</span>
                  <span>Ya probaste otros productos sin éxito</span>
                </li>
              </ul>
            </div>

            <!-- Lida When -->
            <div class="bg-gradient-to-br from-gray-100 to-gray-200 rounded-2xl p-6 md:p-8">
              <h3 class="text-2xl font-bold mb-4">🌸 Elige Lida Booster si...</h3>
              <ul class="space-y-3">
                <li class="flex items-start gap-3">
                  <span class="text-xl">✓</span>
                  <span>Tienes menos de 20 kilos que perder</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-xl">✓</span>
                  <span>Eres sensible al café (ansiedad, nerviosismo)</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-xl">✓</span>
                  <span>Prefieres resultados graduales y permanentes</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-xl">✓</span>
                  <span>Tienes tiroides o hipertensión</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-xl">✓</span>
                  <span>Quieres evitar el efecto rebote</span>
                </li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Can You Combine -->
        <section class="mb-12 bg-ecru-white rounded-2xl p-6 md:p-8">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">💊 ¿Se Pueden Combinar?</h2>
          <p class="text-base md:text-lg text-text-secondary leading-relaxed mb-4">
            <strong>NO.</strong> No recomendamos tomar ambos productos a la vez porque tienen <strong>mecanismos de acción diferentes</strong>:
          </p>
          <ul class="space-y-2 mb-6">
            <li class="flex items-start gap-3">
              <span class="text-red-600 font-bold text-xl">✗</span>
              <span>Duo 60 acelera tu metabolismo (como pedal al fondo en un carro)</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-red-600 font-bold text-xl">✗</span>
              <span>Lida Booster bloquea grasa (como frenos en el carro)</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-red-600 font-bold text-xl">✗</span>
              <span><strong>Tomar ambos = tu cuerpo no sabe qué hacer</strong></span>
            </li>
          </ul>
          <p class="text-base md:text-lg text-como font-semibold">
            ✅ Elige UNO según tu perfil y objetivo. Si dudas, escríbenos por WhatsApp para recomendación personalizada.
          </p>
        </section>

        <!-- Real Testimonials -->
        <section class="mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">💬 ¿Qué Dicen Nuestros Clientes?</h2>
          <p class="text-sm text-text-secondary mb-8">
            Experiencias individuales compartidas por clientes. No son resultados típicos ni garantizados: los resultados varían según cada persona.
          </p>
          
          <div class="grid gap-6 md:grid-cols-2">
            <!-- Testimonio Duo 60 -->
            <div class="bg-white border-2 border-como rounded-xl p-6">
              <div class="flex items-center gap-3 mb-4">
                <div class="text-3xl">⭐⭐⭐⭐⭐</div>
                <span class="font-bold text-como">Duo 60 Fusion</span>
              </div>
              <p class="text-text-secondary italic mb-4">
                "Bajé 12 kilos en 60 días con Duo 60. Tenía que quedar bien para mi boda y lo logré. La energía que da es impresionante, no me daba hambre y bajé rápido."
              </p>
              <p class="text-sm font-semibold text-gray-600">- María, 35 años, CDMX</p>
            </div>

            <!-- Testimonio Lida -->
            <div class="bg-white border-2 border-gray-200 rounded-xl p-6">
              <div class="flex items-center gap-3 mb-4">
                <div class="text-3xl">⭐⭐⭐⭐⭐</div>
                <span class="font-bold text-como">Lida Booster</span>
              </div>
              <p class="text-text-secondary italic mb-4">
                "Lida es suave, no me dio nerviosismo como otros productos. Bajé 15 kilos en 3 meses y lo mejor: ya pasó 1 año y NO he subido de peso. Sigue funcionando."
              </p>
              <p class="text-sm font-semibold text-gray-600">- Ana, 42 años, Guadalajara</p>
            </div>
          </div>
        </section>

        <!-- Final Verdict -->
        <section class="mb-12 bg-gradient-to-br from-como to-[#3d6849] rounded-2xl p-8 md:p-12 text-white text-center">
          <h2 class="text-3xl md:text-4xl font-bold mb-6">🏆 Veredicto Final</h2>
          
          <div class="max-w-3xl mx-auto space-y-4 mb-8">
            <p class="text-lg md:text-xl">
              <strong>Duo 60 Fusion</strong> es para quien necesita <strong>resultados rápidos</strong> y tiene tolerancia a la cafeína. Es la opción que suelen elegir quienes buscan avanzar rápido, teniendo en cuenta que los resultados varían según cada persona.
            </p>
            
            <p class="text-lg md:text-xl">
              <strong>Lida Booster</strong> es para quien prefiere <strong>resultados graduales y permanentes</strong>, sin cafeína, sin nerviosismo. Es tu mejor opción si prefieres estabilidad a rapidez.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a 
              href="/duo-60-fusion/"
              class="inline-flex items-center justify-center gap-2 bg-white text-como px-8 py-4 rounded-full font-bold shadow-xl hover:shadow-2xl active:scale-95 transition-all duration-300"
            >
              Ver Duo 60 Fusion
            </a>
            <a 
              href="/lidabooster/"
              class="inline-flex items-center justify-center gap-2 bg-white/10 backdrop-blur-sm border-2 border-white text-white px-8 py-4 rounded-full font-bold hover:bg-white/20 active:scale-95 transition-all duration-300"
            >
              Ver Lida Booster
            </a>
          </div>
        </section>

        <!-- Need Help -->
        <section class="text-center bg-ecru-white rounded-2xl p-8 md:p-12">
          <h3 class="text-2xl md:text-3xl font-bold mb-4">
            ¿Sigues sin estar seguro?
          </h3>
          <p class="text-lg text-text-secondary mb-6">
            Escríbenos por WhatsApp y te recomendamos el producto perfecto según tu perfil, peso, y objetivo.
          </p>
          <a
            href="#whatsapp-contact"
            class="inline-flex items-center justify-center gap-3 bg-como hover:bg-[#3d6849] text-white font-bold text-base px-8 py-4 md:px-12 md:py-6 shadow-xl hover:shadow-2xl active:scale-95 transition-all duration-300 rounded-full min-h-[56px]"
          >
            <span class="text-2xl">💬</span>
            Hablar con Experto
          </a>
        </section>

      </div>
    </article>

    <Footer />
  </WhatsAppProvider>
</Layout>


