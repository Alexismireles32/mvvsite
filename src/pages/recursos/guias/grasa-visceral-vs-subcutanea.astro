---
import Layout from '../../../layouts/Layout.astro';
import { Navbar6 } from '../../../components/navbar-06.jsx';
import { WhatsAppProvider } from '../../../components/home-wrapper.jsx';
import Footer from '../../../components/Footer.astro';

// BreadcrumbList Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": "https://www.mvvnaturales.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Recursos",
      "item": "https://www.mvvnaturales.com/recursos/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Grasa Visceral vs Subcutánea: ¿Cuál Es Más Peligrosa?",
      "item": "https://www.mvvnaturales.com/recursos/guias/grasa-visceral-vs-subcutanea/"
    }
  ]
};
---

<Layout 
  title="Grasa Visceral vs Subcutánea: ¿Cuál Es Más Peligrosa?"
  description="Diferencias entre grasa visceral y subcutánea. Por qué la visceral es más peligrosa y cómo eliminarla. Guía con soluciones naturales."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <WhatsAppProvider client:load>
    <Navbar6 client:load />

    <article class="px-[5%] py-12 md:py-16 lg:py-20 bg-white">
      <div class="container max-w-4xl mx-auto">
        
        <header class="mb-8 md:mb-12">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4 leading-tight">
            Grasa Visceral vs Subcutánea: ¿Cuál Es Más Peligrosa?
          </h1>
          <p class="text-lg md:text-xl text-text-secondary leading-relaxed">
            No toda la grasa es igual. La visceral (barriga dura) es la peligrosa. Te explico cómo identificarla y eliminarla.
          </p>
        </header>

        <section class="mb-12">
          <p class="text-lg md:text-xl leading-relaxed mb-4">
            Hay dos tipos de grasa abdominal: <strong>subcutánea</strong> (la que puedes pellizcar en la piel) y <strong>visceral</strong> (la que está dentro del abdomen, rodeando órganos).
          </p>
          <p class="text-base text-text-secondary leading-relaxed">
            La visceral es la peligrosa. Está asociada con diabetes, enfermedades cardíacas, hipertensión y resistencia a la insulina. La buena noticia: es la que responde MÁS rápido a dieta y ejercicio.
          </p>
        </section>

        <!-- Comparación -->
        <section class="mb-12">
          <div class="grid md:grid-cols-2 gap-6 mb-8">
            <div class="bg-red-50 border-2 border-red-300 rounded-2xl p-6">
              <h2 class="text-2xl font-bold mb-4 text-red-800">🔴 Grasa Visceral</h2>
              <ul class="space-y-2 text-sm">
                <li>✓ <strong>Dónde está:</strong> Dentro del abdomen, rodeando órganos</li>
                <li>✓ <strong>Cómo se siente:</strong> Barriga dura, tensa</li>
                <li>✓ <strong>Peligrosidad:</strong> MUY PELIGROSA</li>
                <li>✓ <strong>Asociada con:</strong> Diabetes, colesterol alto, hipertensión</li>
                <li>✓ <strong>Fácil de eliminar:</strong> Sí, responde rápido a dieta y ejercicio</li>
              </ul>
            </div>
            <div class="bg-blue-50 border-2 border-blue-300 rounded-2xl p-6">
              <h2 class="text-2xl font-bold mb-4 text-blue-800">🔵 Grasa Subcutánea</h2>
              <ul class="space-y-2 text-sm">
                <li>✓ <strong>Dónde está:</strong> Bajo la piel, la puedes tocar</li>
                <li>✓ <strong>Cómo se siente:</strong> Blanda, puedes pellizcar</li>
                <li>✓ <strong>Peligrosidad:</strong> Menos peligrosa (más estética)</li>
                <li>✓ <strong>Asociada con:</strong> Mayormente estética</li>
                <li>✓ <strong>Fácil de eliminar:</strong> Más difícil, tarda más en bajar</li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Cómo identificar grasa visceral -->
        <section class="mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-6">🔍 Cómo Saber Si Tienes Grasa Visceral</h2>
          
          <div class="bg-yellow-50 border-2 border-yellow-300 rounded-2xl p-6 md:p-8">
            <h3 class="text-xl font-bold mb-4 text-yellow-800">Test Sencillo:</h3>
            <ol class="space-y-3 list-decimal list-inside text-base">
              <li><strong>Mide tu cintura:</strong> A la altura del ombligo</li>
              <li><strong>Si eres mujer:</strong> Más de 80 cm = grasa visceral alta</li>
              <li><strong>Si eres hombre:</strong> Más de 90 cm = grasa visceral alta</li>
              <li><strong>Forma de barriga:</strong> Si es "redonda y dura" = visceral</li>
              <li><strong>Si puedes pellizcar grasa:</strong> Es subcutánea (menos urgente)</li>
            </ol>
          </div>
        </section>

        <!-- Por qué es peligrosa -->
        <section class="mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-6">⚠️ Por Qué la Grasa Visceral Es Peligrosa</h2>
          
          <div class="space-y-4">
            <div class="bg-red-100 border-2 border-red-400 rounded-xl p-5">
              <h3 class="text-xl font-bold mb-2 text-red-800">1. Produce Sustancias Inflamatorias</h3>
              <p class="text-sm text-gray-700">La grasa visceral libera citocinas inflamatorias que afectan todo tu cuerpo, aumentando riesgo de enfermedades.</p>
            </div>
            <div class="bg-orange-100 border-2 border-orange-400 rounded-xl p-5">
              <h3 class="text-xl font-bold mb-2 text-orange-800">2. Afecta la Sensibilidad a la Insulina</h3>
              <p class="text-sm text-gray-700">Puede causar resistencia a insulina y diabetes tipo 2.</p>
            </div>
            <div class="bg-yellow-100 border-2 border-yellow-400 rounded-xl p-5">
              <h3 class="text-xl font-bold mb-2 text-yellow-800">3. Aumenta Colesterol y Triglicéridos</h3>
              <p class="text-sm text-gray-700">Más riesgo de enfermedades cardiovasculares.</p>
            </div>
            <div class="bg-purple-100 border-2 border-purple-400 rounded-xl p-5">
              <h3 class="text-xl font-bold mb-2 text-purple-800">4. Afecta Hormonas</h3>
              <p class="text-sm text-gray-700">Puede alterar producción de hormonas, especialmente en mujeres.</p>
            </div>
          </div>
        </section>

        <!-- Cómo eliminarla -->
        <section class="mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-6">💪 Cómo Eliminar Grasa Visceral (Rápido)</h2>
          
          <div class="space-y-4">
            <div class="bg-gradient-to-r from-como to-[#3d6849] rounded-xl p-6 text-white">
              <h3 class="text-xl font-bold mb-4">1. Cardio Intensivo</h3>
              <p class="text-sm mb-4">HIIT 3-4 veces por semana. La grasa visceral responde RÁPIDO a cardio.</p>
              <a href="/recursos/guias/ejercicios-metabolismo/" class="inline-flex items-center gap-2 text-white font-bold hover:underline">
                Ver rutinas de HIIT →
              </a>
            </div>
            
            <div class="bg-gradient-to-r from-purple-600 to-purple-800 rounded-xl p-6 text-white">
              <h3 class="text-xl font-bold mb-4">2. Dieta Antiinflamatoria</h3>
              <p class="text-sm mb-4">Reduce azúcar, alcohol, alimentos procesados. Aumenta omega 3, frutas y verduras.</p>
            </div>

            <div class="bg-gradient-to-r from-green-600 to-green-800 rounded-xl p-6 text-white">
              <h3 class="text-xl font-bold mb-4">3. Suplementos Específicos</h3>
              <p class="text-sm mb-4">SOS Burn, Duo 60 Fusion o Lida Booster aceleran quema de grasa visceral.</p>
            </div>
          </div>
        </section>

        <!-- CTA Productos -->
        <section class="mb-12 bg-gradient-to-br from-como to-[#3d6849] rounded-2xl p-8 md:p-12 text-white text-center">
          <h2 class="text-3xl md:text-4xl font-bold mb-6">Quemadores Específicos para Barriga</h2>
          <p class="text-lg md:text-xl mb-8 max-w-2xl mx-auto">
            Combina cardio intenso con estos suplementos que atacan específicamente la grasa visceral.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a
              href="/sosburn/"
              class="inline-flex items-center justify-center gap-3 bg-white text-como px-8 py-4 md:px-12 md:py-6 rounded-full font-bold text-base md:text-lg shadow-xl hover:shadow-2xl active:scale-95 transition-all duration-300"
            >
              Ver SOS Burn →
            </a>
            <a
              href="/lidabooster/"
              class="inline-flex items-center justify-center gap-3 bg-white/10 border-2 border-white text-white px-8 py-4 md:px-12 md:py-6 rounded-full font-bold text-base md:text-lg hover:bg-white/20 transition-all duration-300"
            >
              Ver Lida Booster →
            </a>
          </div>
        </section>

        <!-- Enlaces -->
        <section class="mb-8 text-center">
          <p class="text-text-secondary mb-4">💡 <strong>Lee más:</strong></p>
          <div class="flex flex-wrap justify-center gap-4">
            <a href="/recursos/guias/quemar-grasa-abdominal/" class="text-como font-bold hover:underline">
              Guía: Quemar Grasa Abdominal →
            </a>
            <span class="text-gray-400">|</span>
            <a href="/recursos/guias/dieta-grasa-abdominal/" class="text-como font-bold hover:underline">
              Dieta para Barriga →
            </a>
          </div>
        </section>

      </div>
    </article>

    <Footer />
  </WhatsAppProvider>
</Layout>

