---
import Layout from '../../../layouts/Layout.astro';
import { Navbar6 } from '../../../components/navbar-06.jsx';
import { WhatsAppProvider } from '../../../components/home-wrapper.jsx';
import Footer from '../../../components/Footer.astro';

// BreadcrumbList Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": "https://www.mvvnaturales.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Recursos",
      "item": "https://www.mvvnaturales.com/recursos/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Rutina de Ejercicios para Abdomen Plano en 30 Días | MVV Natural",
      "item": "https://www.mvvnaturales.com/recursos/guias/rutina-ejercicios-abdomen/"
    }
  ]
};
---

<Layout 
  title="Rutina de Ejercicios para Abdomen Plano en 30 Días | MVV Natural"
  description="Rutina específica para eliminar grasa abdominal y fortalecer abdominales. 3 niveles: principiante, intermedio, avanzado. Plan de 30 días."
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  <WhatsAppProvider client:load>
    <Navbar6 client:load />

    <article class="px-[5%] py-12 md:py-16 lg:py-20 bg-white">
      <div class="container max-w-4xl mx-auto">
        
        <header class="mb-8 md:mb-12">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4 leading-tight">
            Rutina de Ejercicios para Abdomen Plano
          </h1>
          <p class="text-lg md:text-xl text-text-secondary leading-relaxed">
            Ejercicios específicos para quemar grasa abdominal y fortalecer el core. Tres niveles según tu condición física actual.
          </p>
        </header>

        <section class="mb-12">
          <p class="text-lg md:text-xl leading-relaxed mb-4">
            <strong>IMPORTANTE:</strong> No existe "reducción localizada". No puedes elegir dónde quemar grasa. Lo que SÍ funciona es hacer ejercicios que quemen MÁS calorías totales + fortalecer tu core.
          </p>
          <p class="text-base text-text-secondary leading-relaxed">
            Esta rutina combina ejercicios de HIIT y core para maximizar quema de grasa abdominal en 30 días.
          </p>
        </section>

        <!-- Principiante -->
        <section class="mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-6">🌱 Nivel Principiante (30 días)</h2>
          
          <div class="bg-green-50 border-2 border-green-300 rounded-2xl p-6 md:p-8 mb-6">
            <h3 class="text-2xl font-bold mb-4 text-green-800">Rutina: 20 minutos, 4 días por semana</h3>
            <div class="space-y-3">
              <div class="bg-white rounded-lg p-4">
                <p class="font-bold mb-2">1. Calentamiento (2 min)</p>
                <p class="text-sm text-text-secondary">Marcha en el lugar, brazos circulares</p>
              </div>
              <div class="bg-white rounded-lg p-4">
                <p class="font-bold mb-2">2. Cardio Suave (10 min)</p>
                <ul class="text-sm text-text-secondary space-y-1">
                  <li>• Caminar rápido 3 min</li>
                  <li>• Trote suave 5 min</li>
                  <li>• Caminar rápido 2 min</li>
                </ul>
              </div>
              <div class="bg-white rounded-lg p-4">
                <p class="font-bold mb-2">3. Core Básico (6 min)</p>
                <ul class="text-sm text-text-secondary space-y-1">
                  <li>• Plancha: 3×20 seg (descanso 10 seg)</li>
                  <li>• Crunches: 3×15 rep</li>
                  <li>• Plancha lateral: 2×20 seg cada lado</li>
                </ul>
              </div>
              <div class="bg-white rounded-lg p-4">
                <p class="font-bold mb-2">4. Enfriamiento (2 min)</p>
                <p class="text-sm text-text-secondary">Estiramientos suaves</p>
              </div>
            </div>
          </div>
        </section>

        <!-- Intermedio -->
        <section class="mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-6">⚡ Nivel Intermedio (30 días)</h2>
          
          <div class="bg-blue-50 border-2 border-blue-300 rounded-2xl p-6 md:p-8 mb-6">
            <h3 class="text-2xl font-bold mb-4 text-blue-800">Rutina: 30 minutos, 5 días por semana</h3>
            <div class="space-y-3">
              <div class="bg-white rounded-lg p-4">
                <p class="font-bold mb-2">1. Calentamiento (3 min)</p>
                <p class="text-sm text-text-secondary">Caminar rápido + movimientos articulares</p>
              </div>
              <div class="bg-white rounded-lg p-4">
                <p class="font-bold mb-2">2. HIIT Cardio (15 min)</p>
                <ul class="text-sm text-text-secondary space-y-1">
                  <li>• 30 seg intenso + 30 seg descanso</li>
                  <li>• 8 rondas de: correr, burpees suaves, jumping jacks</li>
                </ul>
              </div>
              <div class="bg-white rounded-lg p-4">
                <p class="font-bold mb-2">3. Core Avanzado (10 min)</p>
                <ul class="text-sm text-text-secondary space-y-1">
                  <li>• Plancha: 4×30 seg</li>
                  <li>• Mountain climbers: 3×20 rep</li>
                  <li>• Bicicleta: 3×20 cada lado</li>
                  <li>• Plancha con elevación de pierna: 2×10 cada pierna</li>
                </ul>
              </div>
              <div class="bg-white rounded-lg p-4">
                <p class="font-bold mb-2">4. Enfriamiento (2 min)</p>
              </div>
            </div>
          </div>
        </section>

        <!-- Avanzado -->
        <section class="mb-12">
          <h2 class="text-3xl md:text-4xl font-bold mb-6">🔥 Nivel Avanzado (30 días)</h2>
          
          <div class="bg-red-50 border-2 border-red-300 rounded-2xl p-6 md:p-8 mb-6">
            <h3 class="text-2xl font-bold mb-4 text-red-800">Rutina: 35 minutos, 6 días por semana</h3>
            <div class="space-y-3">
              <div class="bg-white rounded-lg p-4">
                <p class="font-bold mb-2">1. Calentamiento (5 min)</p>
                <p class="text-sm text-text-secondary">Jumping jacks, burpees suaves, movilidad articular</p>
              </div>
              <div class="bg-white rounded-lg p-4">
                <p class="font-bold mb-2">2. HIIT Intenso (18 min)</p>
                <ul class="text-sm text-text-secondary space-y-1">
                  <li>• 45 seg intenso + 15 seg descanso</li>
                  <li>• 12 rondas: burpees, sprints, mountain climbers, plancha</li>
                </ul>
              </div>
              <div class="bg-white rounded-lg p-4">
                <p class="font-bold mb-2">3. Core Elite (10 min)</p>
                <ul class="text-sm text-text-secondary space-y-1">
                  <li>• Plancha: 5×45 seg</li>
                  <li>• Burpees: 3×15</li>
                  <li>• Bicicleta avanzada: 4×25 cada lado</li>
                  <li>• Piernas elevadas: 3×15</li>
                  <li>• Plancha con rotación: 2×10 cada lado</li>
                </ul>
              </div>
            </div>
          </div>
        </section>

        <!-- CTA -->
        <section class="mb-12 bg-gradient-to-br from-como to-[#3d6849] rounded-2xl p-8 md:p-12 text-white text-center">
          <h2 class="text-3xl md:text-4xl font-bold mb-6">💪 Acelera Resultados con Suplementos</h2>
          <p class="text-lg md:text-xl mb-8 max-w-2xl mx-auto">
            Combinar ejercicio + dieta + suplementos quemadores da resultados 3x más rápido.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a
              href="/duo-60-fusion/"
              class="inline-flex items-center justify-center gap-3 bg-white text-como px-8 py-4 md:px-12 md:py-6 rounded-full font-bold text-base md:text-lg shadow-xl hover:shadow-2xl active:scale-95 transition-all duration-300"
            >
              Ver Duo 60 Fusion →
            </a>
            <a
              href="/sosburn/"
              class="inline-flex items-center justify-center gap-3 bg-white/10 border-2 border-white text-white px-8 py-4 md:px-12 md:py-6 rounded-full font-bold text-base md:text-lg hover:bg-white/20 transition-all duration-300"
            >
              Ver SOS Burn →
            </a>
          </div>
        </section>

        <!-- Enlaces -->
        <section class="mb-8 text-center">
          <p class="text-text-secondary mb-4">💡 <strong>Lee más:</strong></p>
          <div class="flex flex-wrap justify-center gap-4">
            <a href="/recursos/guias/quemar-grasa-abdominal/" class="text-como font-bold hover:underline">
              Guía: Quemar Grasa Abdominal →
            </a>
            <span class="text-gray-400">|</span>
            <a href="/recursos/guias/grasa-visceral-vs-subcutanea/" class="text-como font-bold hover:underline">
              Grasa Visceral →
            </a>
            <span class="text-gray-400">|</span>
            <a href="/recursos/guias/dieta-grasa-abdominal/" class="text-como font-bold hover:underline">
              Dieta para Barriga →
            </a>
          </div>
        </section>

      </div>
    </article>

    <Footer />
  </WhatsAppProvider>
</Layout>

