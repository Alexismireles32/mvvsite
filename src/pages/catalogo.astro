---
import Layout from '../layouts/Layout.astro';

// Import with the ACTUAL filenames (lowercase with dashes)
import { Navbar6 } from '../components/navbar-06.jsx';
import { WhatsAppProvider } from '../components/home-wrapper.jsx';
import { CatalogImageGallery } from '../components/catalog-image-gallery.jsx';
import { Footer2 } from '../components/footer-02.jsx';
---

<Layout 
  title="Catálogo Digital 2025 | Suplementos Naturales MVV Natural"
  description="Explora nuestro catálogo completo de suplementos naturales para bajar de peso. Más de 25 productos originales con 15 años de experiencia. Cotiza por WhatsApp."
>
  <WhatsAppProvider client:load>
    <Navbar6 client:load />
    <CatalogImageGallery client:idle />
    <Footer2 client:idle />
  </WhatsAppProvider>
</Layout>

