---
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article' | 'product';
}

const {
  title = 'MVV Natural - Suplementos Naturales para Bajar de Peso | México y USA',
  description = 'Suplementos 100% naturales para bajar de peso, acelerar metabolismo y controlar antojos. 15 años de experiencia. Envíos a México y USA. Resultados reales comprobados.',
  image = 'https://res.cloudinary.com/dsulhqvza/image/upload/w_1200,h_630,c_pad,b_rgb:F5F1E8/v1761550208/mvvnatural_pbzwrl.png',
  noindex = false,
  ogType
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = 'MVV Natural';

// og:type was previously hardcoded to "website" on all 70 pages. Infer it from
// the route so blog posts announce themselves as articles, unless overridden.
const path = Astro.url.pathname;
const resolvedOgType =
  ogType ?? (path.startsWith('/blog/') || path.startsWith('/recursos/') ? 'article' : 'website');
---

<!DOCTYPE html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Mobile Optimization -->
    <meta name="theme-color" content="#4A7C59" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="MVV Natural" />
    <link rel="apple-touch-icon" href="https://res.cloudinary.com/dsulhqvza/image/upload/v1761550208/mvvnatural_pbzwrl.png" />
    <link rel="manifest" href="/manifest.json" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    
    <!-- No hreflang cluster. This is a single-language (es-MX) site with one URL
         per page; the previous markup declared an "en-US" alternate pointing at
         the same Spanish page, which is an invalid annotation. Spanish-speaking
         users in the USA are served by the same URLs. Re-add a real cluster only
         if a genuine English version is ever built. -->

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image.startsWith('http') ? image : new URL(image, Astro.site).toString()} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_MX" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.startsWith('http') ? image : new URL(image, Astro.site).toString()} />
    
    <!-- External Asset Preconnects -->
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
    <link rel="dns-prefetch" href="https://res.cloudinary.com" />
    
    <!-- Google Fonts - Optimized for Performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Preload critical font -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Gilda+Display&family=Lora:wght@400;600;700&display=swap" as="style" />
    <link href="https://fonts.googleapis.com/css2?family=Gilda+Display&family=Lora:wght@400;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Gilda+Display&family=Lora:wght@400;600;700&display=swap" rel="stylesheet" />
    </noscript>
    
    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "@id": "https://www.mvvnaturales.com/#organization",
        "name": "MVV Natural",
        "alternateName": ["MVV Natural México", "MVV Naturales"],
        "url": "https://www.mvvnaturales.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://res.cloudinary.com/dsulhqvza/image/upload/v1761550208/mvvnatural_pbzwrl.png",
          "width": 500,
          "height": 500
        },
        "description": "Suplementos 100% naturales para bajar de peso, acelerar metabolismo y controlar antojos. 15 años de experiencia. Envíos a México y USA. Resultados reales comprobados.",
        "foundingDate": "2010",
        "numberOfEmployees": {
          "@type": "QuantitativeValue",
          "minValue": 5,
          "maxValue": 50
        },
        "address": [
          {
            "@type": "PostalAddress",
            "addressCountry": "MX"
          },
          {
            "@type": "PostalAddress",
            "addressCountry": "US"
          }
        ],
        "areaServed": [
          {
            "@type": "Country",
            "name": "Mexico"
          },
          {
            "@type": "Country",
            "name": "United States"
          }
        ],
        "contactPoint": [
          {
            "@type": "ContactPoint",
            "contactType": "customer service",
            "telephone": "+52-631-298-2043",
            "email": "contacto@mvvnaturales.com",
            "availableLanguage": ["Spanish", "English"],
            "areaServed": "MX"
          },
          {
            "@type": "ContactPoint",
            "contactType": "customer service",
            "telephone": "+1-520-216-1443",
            "email": "contacto@mvvnaturales.com",
            "availableLanguage": ["Spanish", "English"],
            "areaServed": "US"
          }
        ],
        "sameAs": [
          "https://www.facebook.com/mvvnatural",
          "https://www.instagram.com/mvvnatural"
        ]
      }
    </script>

    <!-- WebSite entity, @id-linked to the Organization above so Google can
         resolve the brand as a single entity across pages. -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://www.mvvnaturales.com/#website",
        "url": "https://www.mvvnaturales.com",
        "name": "MVV Natural",
        "inLanguage": "es-MX",
        "publisher": { "@id": "https://www.mvvnaturales.com/#organization" }
      }
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>
    <main id="main-content" role="main" tabIndex="-1">
    <slot />
    </main>

    <!-- Site-wide medical/safety disclaimer. Rendered from the Layout so it reaches
         every page regardless of which footer component the page uses. -->
    <aside class="bg-como/95 text-white" aria-label="Aviso de seguridad y salud">
      <div class="px-[5%] py-6">
        <div class="mx-auto max-w-3xl text-center text-xs leading-relaxed text-white/80">
          <p>
            ⚠️ <strong>Aviso de Seguridad:</strong> Los productos de MVV Natural son
            <strong>suplementos alimenticios, no medicamentos</strong>. No están destinados a
            diagnosticar, tratar, curar ni prevenir ninguna enfermedad. Los resultados de pérdida de
            peso varían según cada individuo, su metabolismo y su compromiso con la dieta y el
            ejercicio; <strong>no garantizamos resultados específicos</strong>. Consulte a su médico
            antes de comenzar cualquier tratamiento, especialmente si está embarazada o lactando,
            tiene alguna condición médica o toma medicación. La información de este sitio es
            orientativa y no sustituye el consejo médico profesional.
          </p>
        </div>
      </div>
    </aside>

    <SpeedInsights />
  </body>
</html>
